[Unit]
Description=FastAPI Application with Uvicorn
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/fastapi-aws-rds
Environment="PATH=/home/ubuntu/fastapi-aws-rds/venv/bin"
ExecStart=/home/ubuntu/fastapi-aws-rds/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
